   Range = {50, 500},
   Increment = 10,
   Suffix = " Pixels",
   CurrentValue = 100,
   Flag = "FOVSize",
   Callback = function(Value)
       FOV_Radius = Value
       FOVCircle.Radius = Value
   end,
})

-- Loop Utama
RunService.RenderStepped:Connect(function()
    -- Update posisi lingkaran ke tengah layar
    FOVCircle.Position = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)

    if AimbotEnabled and UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then
        local closestPlayer = nil
        local shortestDistance = FOV_Radius -- Batasi jarak pencarian dengan FOV_Radius

        for _, player in pairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("Head") and player.Character:FindFirstChild("Humanoid") then
                
                -- Logika Filter Tim: Jika TeamTag.Enabled == true, maka itu teman
                local teamTag = player.Character:FindFirstChild("TeamTag")
                local isTeammate = (teamTag and teamTag:IsA("BillboardGui") and teamTag.Enabled == true)
                
                if not isTeammate and player.Character.Humanoid.Health > 0 then
                    local headPos, onScreen = Camera:WorldToViewportPoint(player.Character.Head.Position)
                    
                    if onScreen then
                        local distance = (Vector2.new(headPos.X, headPos.Y) - Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)).Magnitude
                        
                        -- Cek apakah di dalam FOV, terlihat (WallCheck), dan paling dekat
                        if distance < shortestDistance and isVisible(player.Character.Head) then
                            shortestDistance = distance
                            closestPlayer = player.Character.Head
                        end
                    end
                end
            end
        end

        if closestPlayer then
            Camera.CFrame = CFrame.lookAt(Camera.CFrame.Position, closestPlayer.Position)
        end
    end
end)
